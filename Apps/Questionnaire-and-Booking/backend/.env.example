
# --- TVE Acquaint ---
ACQUAINT_BASE=https://api.integrators.acquaintcrm.co.uk
ACQUAINT_API_KEY=
ACQUAINT_SITE_PREFIX=

# --- Inbound email intake ---
# webhook (default): the mail provider POSTs raw messages to
#   /webhook/thames-valley-estates/email-intake. No mailbox polling.
# imap (legacy, opt-in): the worker polls the mailbox below.
TVE_EMAIL_INTAKE=webhook

# --- IMAP (legacy polling only) ---
TVE_IMAP_HOST=
TVE_IMAP_PORT=993
TVE_IMAP_USERNAME=
TVE_IMAP_PASSWORD=
TVE_IMAP_MAILBOX=INBOX
# Production-only replay state; Compose mounts tve-imap-checkpoint-data here.
# First connection/new UIDVALIDITY baselines UIDNEXT-1 (no historic intake).
TVE_IMAP_STATE_DIR=/var/lib/tve-imap
TVE_IMAP_POLL_SECONDS=60
TVE_IMAP_MAX_MESSAGES_PER_POLL=25

# --- SMTP ---
TVE_SMTP_HOST=localhost
TVE_SMTP_PORT=1025
TVE_SMTP_USER=local-dev
TVE_SMTP_PASSWORD=local-dev-smtp-password-placeholder
TVE_ENQUIRY_FROM=dev@example.invalid

# --- URL---
BOOKING_BASE_URL=http://localhost:8000
BOOKING_PRIMARY_URL=http://localhost:8000
QUESTIONNAIRE_SUBMIT_BASE_URL=http://localhost:8000
BOOKING_APP_BASE_URL=https://thamesvalley-estate-agents-booking.vercel.app/booking
QUESTIONNAIRE_APP_BASE_URL=https://thamesvalley-estate-agents.vercel.app/questionnaire

# --- Token signing ---
TVE_TOKEN_KEY=<set-a-long-random-token-key>
# Applicant questionnaire/booking token lifetime in days (default 365; expiry is always enforced).
TVE_TOKEN_TTL_DAYS=365
TVE_WEBHOOK_SECRET=sandbox-webhook-secret

# --- Meesix Agent (dedicated n8n webhook header credential; no n8n API key) ---
TVE_AGENT_N8N_WEBHOOK_URL=https://tve-n8n.hedgedge.info/webhook/tve-lead-intelligence-agent
TVE_AGENT_N8N_WEBHOOK_SECRET=<set-the-n8n-agent-webhook-header-secret>
TVE_AGENT_DEFAULT_MODEL=qwen3.5:27b

# --- Sandbox---
sandbox=TRUE

# Dedicated sandbox Postgres account (Compose supplies the five sandbox DSNs).
# Use a separately generated URL-safe password on the estate server.
SANDBOX_POSTGRES_USER=tve_sandbox
SANDBOX_POSTGRES_PASSWORD=
TVE_SANDBOX_TOKEN_KEY=
# Optional sandbox-specific public frontend URLs; otherwise use APP_BASE_URLs.
# SANDBOX_BOOKING_APP_BASE_URL=http://127.0.0.1:3000/booking
# SANDBOX_QUESTIONNAIRE_APP_BASE_URL=http://127.0.0.1:3001/questionnaire

# --- Credential vault ---
# Fernet master key for the encrypted settings store. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TVE_SETTINGS_MASTER_KEY=<generate-with-cryptography-fernet-44-bytes-base64>
TVE_SETTINGS_TTL_SECONDS=5
